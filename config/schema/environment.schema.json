{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.example/eph-openstack/schemas/environment.schema.json",
  "title": "Description d'environnement éphémère",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "deployment", "netbox", "proxmox"],
  "properties": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "purpose_short"],
      "properties": {
        "environment_id": {"type": "integer", "minimum": 1},
        "purpose_short": {"type": "string", "pattern": "^[a-z0-9]{2,8}$"},
        "owner": {"type": "string"},
        "purpose": {"type": "string"},
        "ttl_hours": {"type": "integer", "minimum": 1, "maximum": 720}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string"},
        "placement_strategy": {"enum": ["spread", "pack", "manual"]},
        "terraform_phase": {"enum": ["allocate", "full"]}
      }
    },
    "netbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "tenant", "cluster", "vlan_group", "network_role_vlans"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "site": {"type": "string", "minLength": 1},
        "tenant": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "vlan_group": {"type": "string", "minLength": 1},
        "vrf": {"type": "string"},
        "vm_role": {"type": "string"},
        "platform": {"type": "string"},
        "ephemeral_ip_status": {"enum": ["reserved", "active"]},
        "network_role_vlans": {
          "type": "object",
          "required": ["management"],
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_nodes", "template_vmid", "storage"],
      "properties": {
        "api_url": {"type": "string", "format": "uri"},
        "target_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "pool": {"type": "string"},
        "template_vmid": {"type": "integer", "minimum": 100},
        "template_node": {"type": "string"},
        "storage": {"type": "string", "minLength": 1},
        "snippets_storage": {"type": "string"}
      }
    },
    "kolla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {"type": "string"},
        "registry_namespace": {"type": "string"},
        "passwords_mode": {"enum": ["generate", "vault"]}
      }
    }
  }
}
