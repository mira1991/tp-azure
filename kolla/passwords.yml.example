# Gabarit minimal de passwords.yml — solution de repli si le gabarit complet
# de la version kolla-ansible installée est introuvable (le job
# kolla_generate_config préfère share/kolla-ansible/etc_examples).
#
# NE JAMAIS versionner un passwords.yml rempli. Le fichier réel est :
#   - généré par kolla-genpwd (KOLLA_PASSWORDS_MODE=generate) ou lu depuis
#     Vault (KOLLA_PASSWORDS_MODE=vault) ;
#   - écrit en 0600, masqué des logs, exclu des artefacts publics ;
#   - conservé (artefact à accès restreint / Vault) entre le déploiement
#     source et l'upgrade ;
#   - supprimé du workspace en fin de job (trap) ;
#   - JAMAIS enregistré dans un state Terraform.
---
ceph_rgw_keystone_password:
cinder_database_password:
cinder_keystone_password:
database_password:
designate_database_password:
designate_keystone_password:
docker_registry_password:
glance_database_password:
glance_keystone_password:
haproxy_password:
heat_database_password:
heat_domain_admin_password:
heat_keystone_password:
horizon_secret_key:
keystone_admin_password:
keystone_database_password:
kolla_ssh_key:
  private_key:
  public_key:
mariadb_backup_database_password:
memcache_secret_key:
metadata_secret:
neutron_database_password:
neutron_keystone_password:
nova_api_database_password:
nova_database_password:
nova_keystone_password:
nova_ssh_key:
  private_key:
  public_key:
octavia_ca_password:
octavia_client_ca_password:
octavia_database_password:
octavia_keystone_password:
placement_database_password:
placement_keystone_password:
rabbitmq_cluster_cookie:
rabbitmq_password:
