# globals.yml — rendu par scripts/render-terraform-outputs.py avec :
#   - le contexte Terraform (outputs globals_context : VIP interne, interfaces) ;
#   - kolla/versions/source.yml OU target.yml (bascule d'upgrade) ;
#   - les variables de registry de la pipeline.
# Les interfaces spécifiques à chaque nœud (api/tunnel/neutron_external/storage)
# sont portées par les host_vars générés par Terraform, pas par ce fichier.
---
kolla_base_distro: "{{ kolla_base_distro }}"
openstack_release: "{{ openstack_release }}"
openstack_tag: "{{ kolla_image_tag }}"

kolla_internal_vip_address: "{{ kolla_internal_vip_address }}"

network_interface: "{{ network_interface }}"

docker_registry: "{{ docker_registry }}"
docker_namespace: "{{ docker_namespace }}"

neutron_plugin_agent: "openvswitch"
neutron_external_interface: "{{ neutron_external_interface | default('eth3') }}"

enable_haproxy: "yes"
enable_keepalived: "yes"
enable_mariadb: "yes"
enable_rabbitmq: "yes"
enable_memcached: "yes"

enable_keystone: "yes"
enable_glance: "yes"
enable_nova: "yes"
enable_neutron: "yes"
enable_placement: "yes"
enable_horizon: "yes"
enable_heat: "no"

enable_cinder: "{{ 'yes' if enable_cinder else 'no' }}"
{% if enable_cinder %}
enable_cinder_backend_lvm: "yes"
cinder_volume_group: "cinder-volumes"
{% endif %}

enable_octavia: "{{ 'yes' if enable_octavia else 'no' }}"
enable_designate: "{{ 'yes' if enable_designate else 'no' }}"

# Les computes sont des VM en KVM imbriqué : qemu reste plus sûr si les
# extensions ne sont pas exposées ; kvm est vérifié par validate-kvm.yml.
nova_compute_virt_type: "kvm"

enable_prometheus: "no"
enable_grafana: "no"
